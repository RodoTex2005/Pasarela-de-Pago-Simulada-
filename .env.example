# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a GitHub.
# (Variables previstas para la fase con backend y Docker)
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ORDERS_DB_URL=postgres://user:password@orders-db:5432/orders
INVENTORY_DB_URL=mysql://user:password@inventory-db:3306/inventory
PAYMENTS_DB_URL=mongodb://payments-db:27017/payments
BROKER_URL=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=cambia-esto
JWT_REFRESH_SECRET=cambia-esto-tambien
BANK_TIMEOUT_MS=2000
